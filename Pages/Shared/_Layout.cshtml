<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Indian Film Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Indian_Film_Manager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm ifm-navbar">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <i class="bi bi-film"></i> Indian Film Manager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ifmNav"
                        aria-controls="ifmNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="ifmNav">
                    <ul class="navbar-nav ms-auto">
                        @{
                            var path = ViewContext.HttpContext.Request.Path.Value ?? "";
                        }
                        <li class="nav-item">
                            <a class="nav-link @(path == "/" || path.Equals("/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Cinemas", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Cinemas/Index">Фильмы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Actors", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Actors/Index">Актёры</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Genres", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Genres/Index">Жанры</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="ifm-footer">
        <div class="container text-center">
            &copy; @DateTime.Now.Year Indian Film Manager — каталог индийского кино
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
