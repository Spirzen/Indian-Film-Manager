@page
@model IndianFilmManager.Pages.Genres.IndexModel
@{
    ViewData["Title"] = "Жанры";
}

<div class="ifm-page-header">
    <h1><i class="bi bi-tags"></i> Жанры</h1>
    <p class="subtitle">Классификация фильмов</p>
</div>

<div class="ifm-toolbar">
    <span class="text-muted">Всего: @Model.Genres.Count</span>
    <a asp-page="/Genres/AddEdit" class="btn btn-ifm-primary">
        <i class="bi bi-plus-lg"></i> Добавить жанр
    </a>
</div>

@if (!Model.Genres.Any())
{
    <div class="ifm-empty">
        <div class="icon">🎭</div>
        <p>Список жанров пуст</p>
        <a asp-page="/Genres/AddEdit" class="btn btn-ifm-primary mt-2">Добавить жанр</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var genre in Model.Genres)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="ifm-film-card h-100">
                    <span class="ifm-tag genre mb-2">@genre.Name</span>
                    <div class="actions mt-0 pt-3 border-0">
                        <a asp-page="/Genres/AddEdit" asp-route-id="@genre.Id" class="btn btn-sm btn-ifm-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" class="d-inline" data-confirm-delete>
                            <input type="hidden" name="id" value="@genre.Id" />
                            <button type="submit" class="btn btn-sm btn-ifm-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
