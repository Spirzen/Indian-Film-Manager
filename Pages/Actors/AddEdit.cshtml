@page
@model IndianFilmManager.Pages.Actors.AddEditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Редактировать актёра" : "Добавить актёра";
}

<div class="ifm-page-header">
    <h1>@ViewData["Title"]</h1>
    <p class="subtitle">
        <a asp-page="/Actors/Index"><i class="bi bi-arrow-left"></i> Назад к списку</a>
    </p>
</div>

<div class="ifm-form-card">
    <form method="post">
        <input type="hidden" asp-for="Actor.Id" />
        <div class="mb-3">
            <label asp-for="Actor.Name" class="form-label">Имя актёра</label>
            <input asp-for="Actor.Name" class="form-control" required maxlength="100" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-ifm-primary">Сохранить</button>
            <a asp-page="/Actors/Index" class="btn btn-ifm-outline">Отмена</a>
        </div>
    </form>
</div>
